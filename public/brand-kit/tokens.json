{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "color": {
      "violet": { "$type": "color", "$value": "#6E40F3" },
      "midnight": { "$type": "color", "$value": "#281B55" },
      "aquamarine": { "$type": "color", "$value": "#66E6B5" },
      "lavender": { "$type": "color", "$value": "#F5F7FC" },
      "lightPlum": { "$type": "color", "$value": "#5338A0" },
      "plum": { "$type": "color", "$value": "#362265" },
      "darkPlum": { "$type": "color", "$value": "#201839" },
      "lightLilac": { "$type": "color", "$value": "#E3E3FB" },
      "lilac": { "$type": "color", "$value": "#A990EF" }
    }
  },
  "semantic": {
    "color": {
      "success": { "$type": "color", "$value": "#2FBF8F" },
      "notice": { "$type": "color", "$value": "#E3772A" },
      "error": { "$type": "color", "$value": "#E53950" },
      "information": { "$type": "color", "$value": "#3390B7" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "2xl": { "$type": "dimension", "$value": "32px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "$value": "Source Sans 3"
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "57px",
        "fontWeight": 400,
        "letterSpacing": "0px",
        "lineHeight": 1.05
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "32px",
        "fontWeight": 700,
        "letterSpacing": "0.2px",
        "lineHeight": 1.15
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": "16px",
        "fontWeight": 400,
        "letterSpacing": "0.2px",
        "lineHeight": 1.5
      }
    }
  }
}
