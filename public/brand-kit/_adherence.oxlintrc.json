        "message": "<ChipTone> doesn't accept that prop. Declared props: bg, fg."
      },
      {
        "selector": "JSXOpeningElement[name.name='DatePicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|month|style|key|ref|className|style|children)$/]",
        "message": "<DatePicker> doesn't accept that prop. Declared props: value, onChange, month, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DaySelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:days|selected|onToggle|style|key|ref|className|style|children)$/]",
        "message": "<DaySelector> doesn't accept that prop. Declared props: days, selected, onToggle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|icon|children|actions|onClose|style|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, icon, children, actions, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|meta|tag|onClick|style|key|ref|className|style|children)$/]",
        "message": "<DocumentCard> doesn't accept that prop. Declared props: type, title, meta, tag, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentCard'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:file|medication|note|event)$/]",
        "message": "<DocumentCard> type must be one of 'file' | 'medication' | 'note' | 'event'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FavoriteButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onToggle|size|style|key|ref|className|style|children)$/]",
        "message": "<FavoriteButton> doesn't accept that prop. Declared props: active, onToggle, size, style."
