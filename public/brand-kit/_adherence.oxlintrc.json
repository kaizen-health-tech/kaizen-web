        "selector": "JSXOpeningElement[name.name='FileActionButton'] > JSXAttribute[name.name='purpose'] > Literal[value!=/^(?:download|share|delete|ai|edit|tag)$/]",
        "message": "<FileActionButton> purpose must be one of 'download' | 'share' | 'delete' | 'ai' | 'edit' | 'tag'."
      },
